cabal-version:      3.0
name:               miso-cesium
version:            0.1.0.0
synopsis:           Miso bindings for CesiumJS (GHC wasm backend)
description:        Miso bindings for CesiumJS (GHC wasm backend)
license:            MIT
author:             dmjio
maintainer:         code@dmj.io
category:           Web
build-type:         Simple

common warnings
  ghc-options:
    -funbox-strict-fields -O2 -ferror-spans -fspecialise-aggressively -Wall

common wasm
  if arch(wasm32)
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
    cpp-options:
      -DWASM

library
  import:
    warnings
  build-depends: base < 5, ghc-experimental
  exposed-modules:
    Cesium
    Cesium.Core
    Cesium.Math
    Cesium.Viewer
    Cesium.Events
    Cesium.Entity
    Cesium.DataSource
    Cesium.Imagery
    Cesium.Terrain
    Cesium.Scene
    Cesium.Clock
    Cesium.Tileset
    Cesium.Options
    Cesium.Simple
    Cesium.Browser
    Cesium.SampledPosition
  hs-source-dirs:
    lib
  default-language:
    Haskell2010

executable cesium-hello-globe
  import:
    wasm, warnings
  main-is:
    Main.hs
  other-modules:
    Flights
  build-depends: base < 5, containers, miso, miso-cesium
  hs-source-dirs:
    app
  default-language:
    Haskell2010

-- Native (non-wasm) - a CORS proxy in front of api.adsb.lol for the
-- flight-tracker demo. Not buildable under wasm32-wasi-cabal; run it
-- from the project's *default* devShell instead (see proxy/Main.hs).
executable adsb-proxy
  import:
    warnings
  main-is:
    Main.hs
  ghc-options:
    -threaded
  build-depends:
    base < 5, bytestring, http-client, http-client-tls, http-types, wai, warp
  hs-source-dirs:
    proxy
  default-language:
    Haskell2010
  if arch(wasm32)
    buildable: False
