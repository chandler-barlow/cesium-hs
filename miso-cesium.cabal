cabal-version:      3.0
name:               miso-cesium
version:            0.1.0.0
synopsis:           Miso bindings for CesiumJS (GHC wasm backend)
description:        Miso bindings for CesiumJS (GHC wasm backend)
license:            BSD-3-Clause
author:             dmjio
maintainer:         code@dmj.io
category:           Web
build-type:         Simple

common warnings
  ghc-options:
    -funbox-strict-fields -O2 -ferror-spans -fspecialise-aggressively -Wall

common wasm
  if arch(wasm32)
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
    cpp-options:
      -DWASM

library
  import:
    warnings
  build-depends: base < 5, ghc-experimental
  exposed-modules:
    Cesium
    Cesium.Core
    Cesium.Math
    Cesium.Viewer
    Cesium.Events
  hs-source-dirs:
    lib
  default-language:
    Haskell2010

executable cesium-hello-globe
  import:
    wasm, warnings
  main-is:
    Main.hs
  build-depends: base < 5, miso, miso-cesium
  hs-source-dirs:
    app
  default-language:
    Haskell2010
